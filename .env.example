# ---- Copy to .env for local development. Never commit real secrets. ----
NODE_ENV=development

# Runtime DB role (DML only, subject to row-level security)
DATABASE_URL=postgres://uc_app:uc_app_dev_pw@localhost:5440/uc_dev
# Owner role (migrations only)
DATABASE_OWNER_URL=postgres://uc_owner:uc_owner_dev_pw@localhost:5440/uc_dev
# Integration tests use a separate database that is reset on every run
TEST_DATABASE_URL=postgres://uc_app:uc_app_dev_pw@localhost:5440/uc_test
TEST_DATABASE_OWNER_URL=postgres://uc_owner:uc_owner_dev_pw@localhost:5440/uc_test

REDIS_URL=redis://localhost:6390

# S3-compatible object storage (SeaweedFS in dev, compose profile "storage"). Used from Phase 02 (media).
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=uc-dev-media
S3_ACCESS_KEY_ID=uc_s3_dev
S3_SECRET_ACCESS_KEY=uc_s3_dev_secret
# Dev/test only: create the bucket on first use. Production buckets are provisioned by infrastructure.
S3_AUTO_CREATE_BUCKET=true

# API
API_PORT=4100
API_PUBLIC_URL=http://localhost:4100
# Browser origins allowed to send cookie-authenticated mutations (comma separated)
ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101
MERCHANT_ADMIN_URL=http://localhost:3100
# Shared secret that lets storefront servers forward the shopper's Host header. Generate a long random value.
STOREFRONT_GATEWAY_KEY=change-me-dev-storefront-gateway-key-0123456789
# Set true only behind TLS
COOKIE_SECURE=false
LOG_LEVEL=info

# Sandbox payment gateway (Phase 07): test double that signs fake PSP callbacks. Must be false in production.
PAYMENTS_SANDBOX_ENABLED=true
PAYMENTS_SANDBOX_SECRET=dev-only-sandbox-payment-signing-secret-0123456789

# Demo seed password for all demo users (non-production only, min 12 chars)
SEED_DEMO_PASSWORD=DemoPass!2026
# Phase 10: signs storefront content preview links (15 minutes). Use a private value outside development.
PREVIEW_TOKEN_SECRET=dev-only-storefront-preview-signing-secret-0123
